FROM debian:12-slim AS fmd-emulator_arm64
# add arm64 architecture as workaround for apt-get update on linux amd64
#RUN dpkg --add-architecture arm64
#RUN sed -i "s/deb h/deb [arch=amd64] h/g" /etc/apt/sources.list
#RUN apt update

#RUN apt update && apt install -y --no-install-recommends \
#    libc6 libdbus-1-3 libfontconfig1 libgcc-s1 nano \
#    libpulse0 libtinfo6 libx11-6 libxcb1 libxdamage1 \
#    libnss3 libxcomposite1 libxcursor1 libxi6 \
#    libxext6 libxfixes3 zlib1g libgl1 pulseaudio pulseaudio-utils socat \
#   iputils-ping curl ca-certificates wget unzip procps rsync net-tools \
#    xz-utils python3 bison make gawk gcc dbus f2fs-tools libpcre2-16-0 dnsutils iptables iproute2 tcpdump

## Install base packages with robust apt handling (retries, noninteractive, logging)
ENV DEBIAN_FRONTEND=noninteractive
ENV APT_RETRIES=3
ENV APT_PACKAGES="git adb libc6 libdbus-1-3 libfontconfig1 libgcc-s1 nano libpulse0 libtinfo6 libx11-6 libxcb1 libxdamage1 libnss3 libxcomposite1 libxcursor1 libxi6 libxext6 libxfixes3 zlib1g libgl1 pulseaudio pulseaudio-utils socat iputils-ping curl ca-certificates wget unzip procps rsync net-tools xz-utils python3 python3-pip python3-venv bison make gawk gcc dbus f2fs-tools libpcre2-16-0 dnsutils iptables iproute2 tcpdump"
# ENV APT_PACKAGES="adb libc6 libdbus-1-3 libfontconfig1 libgcc-s1 nano libpulse0 libtinfo6 libx11-6 libxcb1 libxdamage1 libnss3 libxcomposite1 libxcursor1 libxi6 libxext6 libxfixes3 zlib1g libgl1 pulseaudio pulseaudio-utils socat iputils-ping curl ca-certificates wget unzip procps rsync net-tools xz-utils python3 python3-pip python3-venv git bison make gawk gcc dbus f2fs-tools libpcre2-16-0 dnsutils iptables iproute2 tcpdump"
# Use apt-get (scripting-friendly) and retry on transient errors. Print apt logs on failure to aid debugging.
RUN set -eux; \
    apt-get update -o Acquire::Retries=${APT_RETRIES}; \
    apt-get install -y --no-install-recommends ${APT_PACKAGES} || ( \
        echo "apt-get install failed, attempting to fix installs and retry"; \
        apt-get -f install -y || true; \
        apt-get install -y --no-install-recommends ${APT_PACKAGES} || ( \
            echo "Final apt install failed - printing apt logs for diagnosis"; \
            if [ -d /var/log/apt ]; then tail -n +1 /var/log/apt/* || true; fi; \
            if [ -d /var/log/dpkg.log ]; then tail -n +1 /var/log/dpkg.log || true; fi; \
            exit 1; \
        ); \
    ); \
    rm -rf /var/lib/apt/lists/*; \
    apt-get clean


################################
# Install Java
################################
RUN mkdir -p /usr/local/jdk-21
WORKDIR /usr/local/jdk-21
RUN wget https://download.oracle.com/java/21/latest/jdk-21_linux-aarch64_bin.tar.gz
RUN tar --strip-components=1 -xf jdk-21_linux-aarch64_bin.tar.gz
ENV JAVA_HOME=/usr/local/jdk-21
ENV PATH=$JAVA_HOME/bin:$PATH

################################
# Install pulse audio default config
################################
COPY ./emulator/default.pa /etc/pulse/default.pa

################################
# Install Android SDK and tools
################################
RUN mkdir -p /android/sdk/cmdline-tools/latest && mkdir -p /android/sdk/avd && mkdir -p /android/sdk/platforms  \
    && mkdir -p /android/sdk/platform-tools && mkdir -p /android/sdk/system-images  \
    && mkdir /android/tmp && mkdir -p /android/user_home/ && mkdir -p /android/sdk/system-images/android/arm64-v8a/
WORKDIR /android
RUN wget https://dl.google.com/android/repository/commandlinetools-mac-11076708_latest.zip
RUN unzip commandlinetools-mac-11076708_latest.zip  -d /android/tmp
RUN mv /android/tmp/cmdline-tools/* /android/sdk/cmdline-tools/latest/
# Install android platform-tools with retry wrapper
RUN set -eux; \
    retry_cmd() { n=0; until "$@"; do n=$((n+1)); echo "Attempt $n/${APT_RETRIES} failed for: $*"; if [ $n -ge ${APT_RETRIES} ]; then echo "Giving up on: $*"; return 1; fi; sleep 5; done; }; \
    apt-get update -o Acquire::Retries=${APT_RETRIES}; \
    retry_cmd apt-get install -y --no-install-recommends android-sdk-platform-tools; \
    rm -rf /var/lib/apt/lists/*; \
    apt-get clean
RUN cp /usr/lib/android-sdk/platform-tools/* /android/sdk/platform-tools/

# Install Android build-tools 36.1.0 using sdkmanager and verify installation
RUN set -eux; yes | /android/sdk/cmdline-tools/latest/bin/sdkmanager --licenses || true; /android/sdk/cmdline-tools/latest/bin/sdkmanager --sdk_root=/android/sdk "build-tools;36.1.0" || true
RUN sh -c 'if [ -d /android/sdk/build-tools/36.1.0 ]; then echo "Installed Android build-tools: 36.1.0"; else echo "No build-tools 36.1.0 installed by sdkmanager"; echo "Contents of /android/sdk/build-tools:"; ls -la /android/sdk/build-tools || true; fi'

# Install Android NDK (preferred recent stable). Create a stable symlink /android/ndk -> installed version
RUN sh -c 'set -eux; sdkmanager --sdk_root=/android/sdk "ndk;29.0.14206865" || sdkmanager --sdk_root=/android/sdk "ndk;29.0.14206865" || true; if [ -d /android/sdk/ndk ]; then NDKVER=$(ls /android/sdk/ndk | sort -V | tail -n1); ln -sfn /android/sdk/ndk/${NDKVER} /android/ndk; echo "Installed Android NDK: ${NDKVER}"; else echo "No NDK installed by sdkmanager"; fi'

ENV ANDROID_HOME=/android/sdk
ENV ANDROID_SDK_ROOT=/android/sdk
ENV ANDROID_NDK_HOME=/android/ndk/29.0.14206865/
ENV NDK_ROOT=/android/ndk/29.0.14206865/
ENV ANDROID_AVD_HOME=/android/sdk/avd
ENV ANDROID_EMULATOR_HOME=/android/sdk/emulator
ENV ANDROID_USER_HOME=/android/user_home/
ENV PATH=$ANDROID_HOME/cmdline-tools/latest/bin:$PATH
ENV PATH=$ANDROID_HOME/platform-tools:$PATH
ENV PATH=$ANDROID_HOME/emulator/:$PATH
ENV REPO_OS_OVERRIDE=macosx

################################
# Copy adbkey and adbkey.pub
################################
COPY ./emulator/prebuilts/adb/adbkey /android/sdk/emulator/adbkey
COPY ./emulator/prebuilts/adb/adbkey.pub /android/sdk/emulator/adbkey.pub

################################
# Copy scrcpy
################################
RUN mkdir -p /android/scrcpy
COPY ./emulator/prebuilts/adb/scrcpy-server.jar /android/scrcpy/scrcpy-server.jar
RUN chmod +x /android/scrcpy/scrcpy-server.jar || true

# Copy helper watcher script to image so entrypoint can launch it
COPY ./emulator/testing_service/adb_push_and_start_scrcpy.py /usr/local/bin/adb_push_and_start_scrcpy.py
RUN chmod +x /usr/local/bin/adb_push_and_start_scrcpy.py || true

################################
# Prepare Android emulator using prebuilt ARM64 binary
################################
COPY ./emulator/prebuilts/arm64/sdk-repo-linux_aarch64-emulator-standalone-0.zip /android/
RUN unzip /android/sdk-repo-linux_aarch64-emulator-standalone-0.zip -d /android/sdk/
COPY ./emulator/avd/ /android/sdk/avd/

################################
# Install and configure SSH and fail2ban packages (do NOT start services at build time)
################################
RUN set -eux; \
    retry_cmd() { n=0; until "$@"; do n=$((n+1)); echo "Attempt $n/${APT_RETRIES} failed for: $*"; if [ $n -ge ${APT_RETRIES} ]; then echo "Giving up on: $*"; return 1; fi; sleep 5; done; }; \
    apt-get update -o Acquire::Retries=${APT_RETRIES}; \
    retry_cmd apt-get install -y --no-install-recommends openssh-server fail2ban; \
    rm -rf /var/lib/apt/lists/*; \
    apt-get clean
RUN mkdir /var/run/sshd
RUN mkdir -p /root/.ssh && \
    touch /root/.ssh/authorized_keys && \
    for key in ./emulator/prebuilts/ssh/*.pub; do \
        if [ -f "$key" ]; then \
            cat "$key" >> /root/.ssh/authorized_keys; \
        fi; \
    done
RUN chmod 600 /root/.ssh/authorized_keys \
    && chown root:root /root/.ssh/authorized_keys
RUN sed -i 's/#PasswordAuthentication yes/PasswordAuthentication no/' /etc/ssh/sshd_config
RUN sed -i 's/PermitRootLogin prohibit-password/PermitRootLogin without-password/' /etc/ssh/sshd_config

COPY ./emulator/prebuilts/fail2ban/jail.local /etc/fail2ban/jail.local

# Install mitmproxy CA certificate into system trust store so containers trust intercepted TLS
# Copy PEM and give it a .crt extension in the ca-certificates directory, then update the store
COPY ./emulator/prebuilts/mitmproxy/mitmproxy-ca-cert.pem /usr/local/share/ca-certificates/mitmproxy-ca.crt
RUN update-ca-certificates || true

################################
# Set environment variables in .bashrc
################################
RUN echo 'export JAVA_HOME=/usr/local/jdk-21' >> /root/.bashrc
RUN echo 'export ANDROID_HOME=/android/sdk' >> /root/.bashrc
RUN echo 'export ANDROID_SDK_ROOT=/android/sdk' >> /root/.bashrc
RUN echo 'export ANDROID_AVD_HOME=/android/sdk/avd' >> /root/.bashrc
RUN echo 'export ANDROID_EMULATOR_HOME=/android/sdk/emulator' >> /root/.bashrc
RUN echo 'export ANDROID_USER_HOME=/android/user_home/' >> /root/.bashrc
RUN echo 'export ANDROID_NDK=/android/sdk/29.0.14206865/' >> /root/.bashrc
RUN echo 'export PATH=$JAVA_HOME/bin:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH' >> /root/.bashrc
RUN echo 'export REPO_OS_OVERRIDE=macosx' >> /root/.bashrc

################################
# Add entrypoint that starts services at runtime after a short delay
################################
COPY ./emulator/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

################################
# Install Python dependencies for testing service
################################
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY ./emulator/testing_service/ /android/testing_service/
COPY ./emulator/testing_service/requirements.txt /android/testing_service/requirements.txt
RUN set -eux; \
    if [ -f /android/testing_service/requirements.txt ]; then \
        python3 -m pip install --no-cache-dir -r /android/testing_service/requirements.txt || python3 -m pip install --no-cache-dir -r /android/testing_service/requirements.txt; \
    fi
RUN set -eux; python3 /android/testing_service/app_testing_tools/install_tools.py;
RUN set -eux; python3 /android/testing_service/app_testing_tools/install_acvtool.py



ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["/bin/bash"]
