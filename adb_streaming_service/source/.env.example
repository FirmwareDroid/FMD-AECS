# ─────────────────────────────────────────────────────────────────
# ADB Streaming Service — environment variable reference
# Copy this file to .env and fill in the values for your deployment.
# Lines beginning with # are comments and are ignored at runtime.
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
# IP address the server will bind to (0.0.0.0 = all interfaces)
HOST=0.0.0.0

# TCP port the HTTP/WebSocket server listens on
PORT=9001

# Set to "development" or "test" to enable pino-pretty log output
# and debug-level logging. Leave unset or set to "production" for JSON logs.
NODE_ENV=production

# ── TLS / SSL ─────────────────────────────────────────────────────
# Enable HTTPS/WSS transport. Requires SSL_KEY_PATH and SSL_CERT_PATH.
# WARNING: if AUTH_ENABLED=true and SSL=false, credentials are sent in cleartext.
SSL=false
SSL_KEY_PATH=
SSL_CERT_PATH=

# ── Basic Authentication ──────────────────────────────────────────
# Enable HTTP Basic authentication for all endpoints and WebSocket upgrades.
# When enabled, every request must include a valid Authorization: Basic ... header.
AUTH_ENABLED=false

# Credentials — use strong, randomly generated values in production.
AUTH_USER=admin
AUTH_PASS=changeme

# ── ADB Server Connection ─────────────────────────────────────────
# Comma-separated list of ADB server endpoints (optional).
# When not set, the service auto-discovers ADB servers in the same
# Docker network (see ADB_DISCOVERY_* below).
# Supported formats:
#   host:port           — connects to an ADB server on the given host and port
#   host:port/serial    — connects to a specific device serial on that server
# Example: ADB_SERVER_LIST=192.168.1.10:5037,192.168.1.11:5037
# Fallback: localhost:5037 (used only when both static list and discovery find nothing)
# ADB_SERVER_LIST=

# ── ADB Auto-Discovery ────────────────────────────────────────────
# When enabled (default), the service scans every host on the container's
# local subnet for an open TCP connection on ADB_DISCOVERY_PORT at startup
# and on a regular interval, so newly started ADB containers are picked up
# automatically.  Only private (RFC 1918) addresses are ever probed.
# Set ADB_DISCOVERY_ENABLED=false to disable completely.
ADB_DISCOVERY_ENABLED=true

# TCP port to probe on each candidate host (default: 5037).
ADB_DISCOVERY_PORT=5037

# Per-host TCP connection timeout in milliseconds (default: 500).
ADB_DISCOVERY_TIMEOUT_MS=500

# How often (in ms) to re-scan the network for newly joined containers.
# Set to 0 to disable periodic re-discovery (default: 60000 = 1 minute).
ADB_DISCOVERY_REFRESH_INTERVAL_MS=60000

# Optional comma-separated extra subnets to scan, in "address/netmask" format.
# Example: ADB_DISCOVERY_SUBNETS=10.10.0.1/255.255.255.0
# ADB_DISCOVERY_SUBNETS=

# ── Logging ───────────────────────────────────────────────────────
# Pino log level. One of: trace, debug, info, warn, error, fatal
# Defaults to "debug" in development/test, "info" in production.
LOG_LEVEL=info

# ── CORS ──────────────────────────────────────────────────────────
# Restrict cross-origin access to a specific origin.
# Leave unset (or set to *) to allow any origin — NOT recommended in production
# when AUTH_ENABLED=true because it allows any website to make credentialed requests.
# Example: CORS_ORIGIN=https://app.example.com
CORS_ORIGIN=*

# ── File Upload ───────────────────────────────────────────────────
# Maximum size in bytes for uploaded APK/XAPK/APKM files.
# Default: 524288000 (500 MB)
UPLOAD_MAX_BYTES=524288000

# ── scrcpy / Streaming ────────────────────────────────────────────
# Path to a custom scrcpy server binary (optional).
# Relative paths are resolved from the services/adb directory.
# DEFAULT_SERVER_PATH=

# Number of consecutive audio packet drops before the audio stream is aborted.
# Default: 200
AUDIO_DROP_ABORT_THRESHOLD=200
