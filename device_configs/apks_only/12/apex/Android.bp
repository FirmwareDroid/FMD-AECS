package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex_key {
    name: "com.android.fmd.key",
    public_key: "com.android.fmd.avbpubkey",
    private_key: "com.android.fmd.pem",
}

android_app_certificate {
    name: "com.android.fmd.certificate",
    certificate: "com.android.fmd",
}

cc_prebuilt_binary {
    name: "app_process64_fmd2",
    stem: "app_process64",
    installable: false,
    srcs: [
        "app_process64",
    ],
    apex_available: [
        "com.android.fmd",
    ],
    static_libs: [
        "libc++_fmd_static",
        "liblog_fmd_static",
        "libbinder_fmd_static",
        "libc_fmd_static",
        "libandroid_runtime_fmd_static",
        "libcutils_fmd_static",
        "libhidlbase_fmd_static",
        "libnativeloader_fmd_static",
        "libsigchain_fmd_static",
        "libutils_fmd_static",
        "libwilhelm_fmd_static",
        "libm_fmd_static",
        "libdl_fmd_static"
    ],
    visibility: [
        "//visibility:public",
    ],
    vendor_available: true,
}

cc_prebuilt_library {
    name: "libc++_fmd_static",
    srcs: [
        "./libc++.so",
