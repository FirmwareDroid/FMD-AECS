on post-fs-data
    mkdir /data/ecapture 0777 root root
    restorecon /data/ecapture

service ecapture /system/bin/ecapture tls -m pcapng --pcapfile /data/ecapture/ecapture.pcapng -k /data/ecapture/sslkey.log
    class late_start
    user root
    group root
    seclabel u:r:su:s0

on property:sys.boot_completed=1
    start ecapture
